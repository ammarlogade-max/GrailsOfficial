# Copy this file to .env.local and fill in your own project's values.
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay publishable key (safe to expose client-side). The secret key
# lives ONLY in the Supabase Edge Function environment (see SETUP.md) —
# never put it in this file or anywhere in the frontend.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
